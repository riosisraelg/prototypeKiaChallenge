# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id-here

# AWS IoT Core Configuration
IOT_ENDPOINT=xxxxx.iot.us-east-1.amazonaws.com
IOT_THING_NAME=kia-paintshop-simulator
IOT_CERT_PATH=simulator/certs/device.crt
IOT_KEY_PATH=simulator/certs/device.key
IOT_CA_PATH=simulator/certs/AmazonRootCA1.pem

# Simulator Configuration
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_ANOMALY_PROBABILITY=0.05
SIMULATOR_VARIABLES_COUNT=100

# DynamoDB Tables
DYNAMODB_SENSOR_DATA_TABLE=kia-paintshop-sensor-data
DYNAMODB_ALARMS_TABLE=kia-paintshop-alarms
DYNAMODB_STATISTICS_TABLE=kia-paintshop-statistics
DYNAMODB_VARIABLES_METADATA_TABLE=kia-paintshop-variables-metadata

# API Configuration
API_URL=https://xxxxx.execute-api.us-east-1.amazonaws.com/demo
API_KEY=your-api-key-here

# Dashboard Configuration (React)
REACT_APP_API_URL=https://xxxxx.execute-api.us-east-1.amazonaws.com/demo
REACT_APP_API_KEY=your-api-key-here
REACT_APP_REFRESH_INTERVAL=30000

# EventBridge Configuration
EVENTBRIDGE_BUS_NAME=kia-paintshop-events

# S3 Configuration
S3_ARCHIVE_BUCKET=kia-paintshop-archive-{account-id}

# CloudWatch Configuration
CLOUDWATCH_NAMESPACE=KIA/PaintShop
LOG_LEVEL=INFO

# Cost Monitoring
BUDGET_LIMIT_USD=50
COST_ALERT_THRESHOLD_USD=20
